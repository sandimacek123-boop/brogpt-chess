{
  "name": "the-infinite-equation",
  "version": "1.0.0",
  "description": "15s vertical cinematic math film rendered with Three.js + custom GLSL, frame-deterministic",
  "scripts": {
    "preview": "node render.js stills --scale 0.5",
    "render:draft": "node render.js frames --scale 0.34 --out out/prev --workers 2",
    "render": "node render.js frames --scale 1 --sub 6 --workers 2 --out out/final",
    "encode": "node render.js encode --out out/final",
    "cicada:preview": "node render.js stills --page cicada.html --scale 0.4 --out out/cstills",
    "cicada:render": "node render.js frames --page cicada.html --scale 1 --sub 6 --workers 2 --out out/cfinal",
    "cicada:encode": "node render.js encode --out out/cfinal --name cicada-3301-edit.mp4 --crf 19"
  },
  "license": "ISC",
  "dependencies": {
    "@fontsource/anton": "^5.1.0",
    "@fontsource/cormorant-garamond": "^5.1.0",
    "@fontsource/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@fontsource/noto-sans-runic": "^5.1.0",
    "katex": "^0.16.11",
    "opentype.js": "^1.3.4",
    "three": "^0.170.0"
  },
  "private": true
}
