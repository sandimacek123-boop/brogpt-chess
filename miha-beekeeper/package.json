{
  "name": "miha-beekeeper",
  "version": "1.0.0",
  "private": true,
  "description": "Miha — a Slovenian beekeeper's life (1945–2024). Remotion, 2560x1440, 60 fps, 128 s",
  "type": "module",
  "scripts": {
    "music": "python3 scripts/music.py",
    "studio": "remotion studio src/index.ts",
