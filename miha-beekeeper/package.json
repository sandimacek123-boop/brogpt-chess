    "still": "remotion still src/index.ts Miha",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/playfair-display": "5.2.8",
    "@remotion/cli": "4.0.540",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "remotion": "4.0.540"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "typescript": "5.9.3"
  }
}
