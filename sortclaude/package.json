{
  "name": "sortclaude",
  "productName": "SortClaude 5.5",
  "version": "5.5.0",
  "description": "SortClaude 5.5 — cinematic, scientifically accurate sorting algorithm visualizer",
  "author": "SortClaude Team",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p electron/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "electron:compile": "node scripts/build-electron.mjs",
    "electron:dev": "npm run build && npm run electron:compile && electron .",
    "electron:start": "npm run electron:compile && electron .",
    "icons": "node scripts/make-icons.mjs",
    "dist:win": "npm run build && npm run electron:compile && electron-builder --win nsis portable --x64",
    "dist:linux": "npm run build && npm run electron:compile && electron-builder --linux dir"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "codemirror": "^6.0.1",
    "mp4-muxer": "^5.1.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "webm-muxer": "^5.0.3",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
